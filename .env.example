DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_minimarket

# Optional: Vercel Blob credentials for image uploads.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Required for signed login sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Google AI Studio API key. Keep the project on Free tier for free API usage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared application caps; separate from Google's quota. Daily reset: midnight Pacific (14:00/15:00 WIB).
AI_DAILY_LIMIT=500
AI_MINUTE_LIMIT=15
